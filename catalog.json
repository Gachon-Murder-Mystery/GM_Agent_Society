    {
      "id": 0,
      "name": "라운지 칸",
      "description": "벨벳 의자와 식어가는 차. 창문에 비친 승객들은 서로의 눈을 피합니다."
    },
    {
      "id": 1,
      "name": "침대 칸",
      "description": "좁은 복도에 황동 객실 번호가 늘어서 있습니다. 문틈 사이로 불빛이 새어 나옵니다."
    },
    {
      "id": 2,
      "name": "식당 칸",
      "description": "하얀 식탁보 위의 은식기가 열차의 진동에 부딪힙니다. 차장이 승객들을 모으고 있습니다."
    },
    {
      "id": 3,
      "name": "주방 칸",
      "description": "희미한 증기와 버터 냄새. 도마와 조리 도구가 정돈되어 있습니다."
    },
    {
      "id": 4,
      "name": "수하물 칸",
      "description": "가죽 트렁크들이 선반에 빼곡합니다. 바닥을 타고 열차의 진동이 전해집니다."
    },
    {
      "id": 5,
      "name": "금고 칸",
      "description": "금속 문 옆에 보관 장부가 놓여 있습니다. 피해자의 재산도 이곳에 있다고 합니다."
    },
    {
      "id": 6,
      "name": "전망 칸",
      "description": "커다란 유리창 너머로 황무지가 펼쳐집니다. 창가 의자 사이에 작은 테이블이 놓여 있습니다."
    },
    {
      "id": 7,
      "name": "기관실",
      "description": "피스톤의 굉음 때문에 목소리를 높여야 합니다. 계기판의 바늘이 흔들립니다."
    }
